[icann]
username = TU_USUARIO_ICANN
password = TU_PASSWORD_ICANN

[hosting]
url = https://tudominio.com
api_key = TU_API_KEY

[worker]
download_dir = ./zones
data_dir = ./data
batch_size = 10000
; Seconds between command polls in daemon mode (lower = snappier web actions).
poll_interval = 20
max_retries = 5
; Delay (seconds) before an enqueued sync/TLD retry (grows with each attempt).
retry_delay_seconds = 300
; Maximum age in days for domains to be considered during recheck.
; Domains first_seen older than this will be skipped.
max_domain_age_days = 30
; Hard cap of domains checked per recheck run (0 = no cap). Protects against a
; very long ICANN/CZDS recheck; the UI can override it per run.
recheck_max_domains = 0

; --- Automatic WHOIS after a download ---
; Cache the WHOIS/RDAP registration data of newly matched domains right after
; each download, so the panel and reports already show creation dates (no
; manual "Fetch WHOIS"). Uses the [whois] settings (rate_delay, disabled_tlds,
; overrides). Rechecks never trigger it. Set to false to disable.
auto_whois = true
; Cap the number of WHOIS lookups per run (protects the registries). 0 = skip.
auto_whois_max = 200

; --- Automatic daily run (daemon mode) ---
; In daemon mode the worker triggers one full cycle per local day after this
; time, so no cron is needed. The daily guard still skips TLDs already
; processed today. Set auto_daily = false to disable it (cron mode).
auto_daily = true
daily_run_time = 04:00
daily_run_timezone = Europe/Madrid

; --- Large zone handling (CZDS) ---
; Refuse to download a zone bigger than this (GB). 0 = no hard limit.
max_zone_size_gb = 0
; Require at least this many GB free after finishing a download.
min_free_disk_gb = 5
; Zones >= this size (MB, compressed) are cached as 64-bit hashes instead of
; domain text, which keeps the local DB small for TLDs like .com.
hash_cache_min_mb = 512
; Keep the .zone.gz file on disk for hash-cached (huge) TLDs. false frees the
; multi-GB file after parsing.
retain_zone_hash_tlds = false
; Immediate download retries before the TLD is queued for the next cycle.
max_download_retries = 3
; Commit + WAL checkpoint every N batches (1 batch = 50k domains) so huge zones
; like .com do not grow the SQLite WAL without bound during a single parse.
commit_every_batches = 10
; SQLite page cache in MB for the worker database.
; Default 2048 MB suits an 8 GB host; lower it (e.g. 512) on hosts with less RAM.
sqlite_cache_mb = 2048
; NORMAL = durable; OFF = skip fsync during the bulk parse (faster, but a crash
; can corrupt worker.db, which is a rebuildable cache).
sqlite_synchronous_parse = OFF

[tlds]
; Comma-separated list of TLDs to process. Leave empty to process all approved TLDs.
whitelist = zip, wine

[whois]
; On-demand domain registration lookups requested from the web panel.
; RDAP is used first; the WHOIS port 43 fallback covers TLDs without RDAP.
timeout = 20
; TCP connect timeout: fail fast on registries that block/refuse port 43.
connect_timeout = 6
rdap_only = false
whois_fallback = true
; Seconds to wait between lookups (be polite to the registries).
rate_delay = 1.0
; Registries that restrict WHOIS port 43 (authorized IPs only) or publish no
; data. They return "unsupported" without a network call (the panel then shows
; the first seen in zone data). Empty value disables the shortcut.
; .es (Red.es) only serves WHOIS to pre-authorized IPs; .de (DENIC) publishes
; no creation date. Set rdap_overrides for RDAP servers missing from IANA.
disabled_tlds = es
rdap_overrides = de=https://rdap.denic.de/
whois_overrides =

[virustotal]
; VirusTotal API v3 key (https://www.virustotal.com/gui/my-apikey). The free
; public API allows 4 requests/minute and 500/day; keep the values below in
; sync with your plan.
api_key = TU_API_KEY_VIRUSTOTAL
; Seconds between lookups (16 keeps it under 4 requests/minute).
rate_delay_seconds = 16
; Hard cap of lookups per calendar day (UTC).
daily_limit = 500
; Skip domains already checked within this many days (unless force is requested).
cache_days = 7
timeout = 20

[abusech]
; abuse.ch community API Auth-Key (https://auth.abuse.ch/). A single free key
; covers both URLhaus (malware distribution sites) and ThreatFox (confirmed
; IOCs). Used to validate the domains matched by your keywords: one URLhaus
; `host` lookup + one ThreatFox `search_ioc` lookup per domain.
auth_key = TU_AUTH_KEY_ABUSECH
; Seconds between domain lookups (each domain may be two requests).
rate_delay_seconds = 1.0
; Hard cap of domain lookups per calendar day (UTC).
daily_limit = 10000
; Skip domains already checked within this many days (unless force is requested).
cache_days = 7
timeout = 20
; Sources queried on demand. Disable one to halve the requests per domain.
urlhaus_enabled = true
threatfox_enabled = true

[openintel]
; Weekly ccTLD apex-domain lists from OpenINTEL (see README).
; Data license: CC BY-NC-SA 4.0 (non-commercial, attribution required).
; You must read and accept the OpenINTEL terms before enabling this:
;   https://www.openintel.nl/download/terms/
enabled = false
accept_terms = false
; Comma-separated ccTLDs to process. This is only a FALLBACK used when the
; web panel is unreachable or has no active ccTLD: the ccTLDs activated in the
; panel (TLDs -> ccTLD) are the source of truth and are processed automatically.
; Recommended: leave empty.
tlds =
; Where the parquet files and the local seen-set database are stored.
data_dir = ./data/openintel
; Optional explicit DB path (defaults to <data_dir>/openintel.db).
db_path =
; Be gentle: seconds between index requests and between file downloads.
sleep_http = 3
sleep_between = 10
; Keep the downloaded .parquet.gz after processing (false frees disk).
keep_files = false
; Confirm the WHOIS/RDAP creation date for keyword candidates before notifying.
whois_confirm = true
whois_max_age_days = 30
; Cap the number of WHOIS confirmations per run (protects the registries).
whois_max_lookups = 200
