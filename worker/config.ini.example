[icann]
username = TU_USUARIO_ICANN
password = TU_PASSWORD_ICANN

[hosting]
url = https://tudominio.com
api_key = TU_API_KEY

[worker]
download_dir = ./zones
data_dir = ./data
batch_size = 10000
; Seconds between command polls in daemon mode (lower = snappier web actions).
poll_interval = 20
max_retries = 5
; Delay (seconds) before an enqueued sync/TLD retry (grows with each attempt).
retry_delay_seconds = 300
; Maximum age in days for domains to be considered during recheck.
; Domains first_seen older than this will be skipped.
max_domain_age_days = 30

; --- Large zone handling (CZDS) ---
; Refuse to download a zone bigger than this (GB). 0 = no hard limit.
max_zone_size_gb = 0
; Require at least this many GB free after finishing a download.
min_free_disk_gb = 5
; Zones >= this size (MB, compressed) are cached as 64-bit hashes instead of
; domain text, which keeps the local DB small for TLDs like .com.
hash_cache_min_mb = 512
; Keep the .zone.gz file on disk for hash-cached (huge) TLDs. false frees the
; multi-GB file after parsing.
retain_zone_hash_tlds = false
; Immediate download retries before the TLD is queued for the next cycle.
max_download_retries = 3
; Commit + WAL checkpoint every N batches (1 batch = 50k domains) so huge zones
; like .com do not grow the SQLite WAL without bound during a single parse.
commit_every_batches = 10
; SQLite page cache in MB for the worker database.
sqlite_cache_mb = 512
; NORMAL = durable; OFF = skip fsync during the bulk parse (faster, but a crash
; can corrupt worker.db, which is a rebuildable cache).
sqlite_synchronous_parse = OFF

[tlds]
; Comma-separated list of TLDs to process. Leave empty to process all approved TLDs.
whitelist = zip, wine

[whois]
; On-demand domain registration lookups requested from the web panel.
; RDAP is used first; the WHOIS port 43 fallback covers TLDs without RDAP.
timeout = 20
rdap_only = false
whois_fallback = true
; Seconds to wait between lookups (be polite to the registries).
rate_delay = 1.0
